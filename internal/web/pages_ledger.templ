package web

// LedgerPage renders a registered report: shell + pageBody from PageRegistry.
templ LedgerPage(d pageData) {
	@reportLayout(d) {
		@pageBody(d)
	}
}

templ pluginsBody(d pageData) {
	<section class="mb-6">
		<p class="text-xs text-base-content/60 mb-3">
			Registered first-party modules and whether they are enabled after CUE unify
			(journal <code class="font-mono">plugin "…"</code> and <code class="font-mono">plugins</code> in contapila.cue).
		</p>
		if len(d.PluginRows) == 0 {
			<p class="text-xs text-base-content/60">No modules registered in this binary.</p>
		} else {
			@borderTable() {
				<table class="table table-xs">
					<thead>
						<tr>
							<th>ID</th>
							<th class="w-20">Enabled</th>
							<th class="w-24">In config</th>
							<th class="w-20">Stream</th>
							<th>Entry (CUE)</th>
						</tr>
					</thead>
					<tbody>
						for _, row := range d.PluginRows {
							<tr>
								<td class="font-mono text-[0.7rem]">{ row.ID }</td>
								<td>
									if row.Enabled {
										<span class="text-success font-medium text-xs">on</span>
									} else {
										<span class="text-base-content/50 text-xs">off</span>
									}
								</td>
								<td class="text-xs">
									if row.InConfig {
										yes
									} else {
										<span class="text-base-content/50">default</span>
									}
								</td>
								<td class="text-xs">
									if row.HasStream {
										yes
									} else {
										—
									}
								</td>
								<td class="max-w-xl overflow-x-auto">
									@codeHighlight(row.EntryCUE, "cue")
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		}
	</section>
	<section>
		<h2 class="text-[0.65rem] uppercase tracking-wide text-base-content/50 mb-2">plugins (unified)</h2>
		<div class="p-3 bg-base-200 border border-base-300 overflow-x-auto">
			@codeHighlight(d.PluginsCUE, "cue")
		</div>
	</section>
}

templ configBody(d pageData) {
	<div class="flex min-h-0 flex-1 flex-col gap-2">
		<p class="shrink-0 text-xs text-base-content/60">
			Prelude ⊔ discovered ledgers ⊔ price pairs ⊔ journal plugins ⊔ contapila.cue
		</p>
		<div class="min-h-0 flex-1 overflow-auto border border-base-300 bg-base-200 p-3">
			@codeHighlight(d.ConfigCUE, "cue")
		</div>
	</div>
}

templ checkBody(d pageData) {
	if d.OK {
		<div role="alert" class="alert alert-success alert-soft py-2 text-xs mb-3">
			<span class="font-medium">Check passed</span>
			<span class="opacity-80">No hard errors.</span>
		</div>
	} else {
		<div role="alert" class="alert alert-error alert-soft py-2 text-xs mb-3">
			<span class="font-medium">Check failed</span>
		</div>
	}
	if len(d.Diags) > 0 {
		@borderTable() {
			<table class="table table-xs">
				<thead>
					<tr>
						<th class="w-16">Sev</th>
						<th>Message</th>
						<th>Location</th>
					</tr>
				</thead>
				<tbody>
					for _, dg := range d.Diags {
						<tr>
							<td>
								if dg.IsError() {
									<span class="text-error font-medium text-xs">error</span>
								} else {
									<span class="text-warning font-medium text-xs">warn</span>
								}
							</td>
							<td class="max-w-xl text-xs">{ dg.Message }</td>
							<td class="font-mono text-[0.7rem] opacity-60">{ dg.Location() }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	} else {
		@emptyNote("No diagnostics.")
	}
}

templ balancesBody(d pageData) {
	if len(d.BalanceRows) == 0 {
		@emptyNote("No balances for this as-of date.")
	} else {
		@borderTable() {
			<table class="table table-xs pnl-tree" data-pnl-tree>
				<thead>
					<tr>
						<th>Account</th>
						<th class="text-right">Amount</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range d.BalanceRows {
						<tr
							class={ templ.KV("font-semibold bg-base-200/40", r.IsRollup) }
							data-account={ treeDataAccount(r.Path, r.Account) }
						>
							@treeAccountCell(d.Sess, r, d.LedgerName, d.Time)
							<td class="text-right tabular text-xs font-medium whitespace-nowrap">
								@amountWithCommodityLink(d.Sess, r.Amount, r.Commodity, d.LedgerName, d.Time, r.IsRollup)
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		@pnlTreeScript()
	}
}

templ pnlBody(d pageData) {
	@chartPanel(d)
	<p class="mb-2 text-[0.65rem] text-base-content/50">
		Beancount signs: income credits are negative, expenses debits positive. Amounts in
		if d.OpCurrency != "" {
			{ d.OpCurrency }
		} else {
			native units
		}
		.
	</p>
	<div class="grid gap-4 md:grid-cols-2">
		@pnlSideTree(d.Sess, "Income", d.IncomeRows, d.LedgerName, d.Time, "No income postings.")
		@pnlSideTree(d.Sess, "Expenses", d.ExpenseRows, d.LedgerName, d.Time, "No expense postings.")
	</div>
	@pnlTreeScript()
}

templ networthBody(d pageData) {
	if d.Error == "" {
		@chartPanel(d)
		<div class="mb-3 flex items-baseline gap-3 border border-base-300 bg-base-200 px-3 py-2">
			<div>
				<div class="text-[0.65rem] uppercase tracking-wide text-base-content/50">Net worth</div>
				<div class="money-highlight text-xl font-semibold tabular leading-tight">{ d.NetWorthTot }</div>
				<div class="text-xs text-base-content/60">
					{ d.OpCurrency }
					if d.AsOf != "" {
						{ " · " + d.AsOf }
					}
				</div>
			</div>
		</div>
		if len(d.NetWorthRows) == 0 {
			@emptyNote("No asset/liability positions.")
		} else {
			@borderTable() {
				<table class="table table-xs pnl-tree" data-pnl-tree>
					<thead>
						<tr>
							<th>Account</th>
							<th class="text-right">Units</th>
							<th class="text-right">Value</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, r := range d.NetWorthRows {
							<tr
								class={ templ.KV("font-semibold bg-base-200/40", r.IsRollup) }
								data-account={ r.Path }
							>
								@treeAccountCellNW(d.Sess, r, d.LedgerName, d.Time)
								<td class="text-right tabular text-xs font-medium whitespace-nowrap">
									@amountWithCommodityLink(d.Sess, r.Units, r.Commodity, d.LedgerName, d.Time, r.IsRollup)
								</td>
								<td class="text-right tabular text-xs font-medium whitespace-nowrap">
									{ r.Value }
									if d.OpCurrency != "" {
										{ " " }
										@CommodityLink(d.Sess, d.LedgerName, d.OpCurrency, d.Time, true)
									}
								</td>
								<td class="text-[0.65rem] text-warning">
									if r.Unpriced {
										no px
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			@pnlTreeScript()
		}
	}
}

templ documentsBody(d pageData) {
	if len(d.Documents) == 0 {
		@emptyNote("No documents for this ledger.")
	} else {
		@borderTable() {
			<table class="table table-xs pnl-tree" data-pnl-tree>
				<thead>
					<tr>
						<th>Account</th>
						<th class="text-right">Date</th>
						<th>File</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range d.Documents {
						<tr
							class={ templ.KV("font-semibold bg-base-200/40", r.IsRollup) }
							data-account={ treeDataAccount(r.TreePath, r.Account) }
						>
							<td
								class="font-mono text-xs"
								if r.PadLeft != "" {
									style={ "padding-left: " + r.PadLeft }
								}
							>
								@treeToggle(r.IsRollup)
								if r.IsDoc {
									@fileLink(r.Href, r.Path, r.Name, true)
								} else if r.Account != "" {
									@AccountLink(d.Sess, d.LedgerName, r.Account, d.Time, r.Name)
								} else {
									<span>{ r.Name }</span>
								}
							</td>
							<td class="text-right font-mono tabular text-xs text-base-content/70">{ r.Date }</td>
							<td class="font-mono text-xs">
								if !r.IsDoc && !r.IsRollup && (r.Href != "" || r.FileName != "") {
									if r.FileName != "" {
										@fileLink(r.Href, r.Path, r.FileName, false)
									} else {
										@fileLink(r.Href, r.Path, r.Name, false)
									}
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		@pnlTreeScript()
	}
}

templ pricesBody(d pageData) {
	<p class="mb-2 text-xs text-base-content/60">Shared project prices (<span class="font-mono">prices.beancount</span>) — last write wins per day. Open a base commodity for its full price chart.</p>
	if d.Error == "" {
		@chartPanel(d)
	}
	if len(d.PriceSeries) == 0 {
		@emptyNote("No prices loaded.")
	} else {
		@borderTable() {
			<table class="table table-xs table-zebra">
				<thead>
					<tr>
						<th>Base</th>
						<th class="text-right">Points</th>
						<th>First</th>
						<th>Last</th>
						<th class="text-right">Last price</th>
						<th>Last meta</th>
					</tr>
				</thead>
				<tbody>
					for _, s := range d.PriceSeries {
						<tr>
							<td class="font-mono text-xs">
								@CommodityLink(d.Sess, d.LedgerName, s.Base, d.Time, false)
							</td>
							<td class="text-right tabular text-xs">{ fmtInt(s.Count) }</td>
							<td class="font-mono tabular text-xs text-base-content/70">{ s.FirstDate }</td>
							<td class="font-mono tabular text-xs text-base-content/70">{ s.LastDate }</td>
							<td class="text-right tabular text-xs font-medium font-mono">
								@rateWithQuote(d.Sess, s.LastRate, s.Quote, d.LedgerName, d.Time)
							</td>
							<td class="text-xs text-base-content/70">
								@metaInline(s.LastMeta)
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}
