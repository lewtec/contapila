package web

templ CommodityPage(d pageData) {
	@reportLayout(d) {
		@chartPanel(d)
		if len(d.CommodityMeta) > 0 {
			<section class="mb-4">
				@sectionTitle("Metadata")
				@metaKVRows(d.CommodityMeta)
			</section>
		}
		if len(d.CommodityPrices) > 0 {
			<section class="mb-4">
				@sectionTitleExtra("Prices") {
					<a class="ml-2 font-normal normal-case tracking-normal link link-hover link-primary text-xs" href={ templ.SafeURL(ledgerURL(d.Sess, d.LedgerName, "prices", d.Time)) }>all pairs</a>
				}
				@borderTable() {
					<table class="table table-xs table-zebra">
						<thead>
							<tr>
								<th>Date</th>
								<th class="text-right">Price</th>
								<th>Meta</th>
							</tr>
						</thead>
						<tbody>
							for _, p := range d.CommodityPrices {
								<tr>
									<td class="font-mono tabular text-xs text-base-content/70">{ p.Date }</td>
									<td class="text-right tabular text-xs font-medium font-mono">
										@rateWithQuote(d.Sess, p.Rate, p.Quote, d.LedgerName, d.Time)
									</td>
									<td class="text-xs text-base-content/70">
										@metaInline(p.Metadata)
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</section>
		}
		<div class="grid gap-4 md:grid-cols-2 mb-4">
			<section>
				@sectionTitle("Balance by account")
				@accountAmountRows(d.Sess, d.CommodityBalances, d.LedgerName, d.Time, "Zero / never held.")
			</section>
			<section>
				@sectionTitle("Change in period")
				@accountAmountRows(d.Sess, d.CommodityActivity, d.LedgerName, d.Time, "No activity.")
			</section>
		</div>
		<section>
			@sectionTitle("Journal")
			@journalList(d)
		</section>
	}
}
