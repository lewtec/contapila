package web

import (
	"github.com/lucasew/contapila-go/internal/ast"
	"github.com/lucasew/contapila-go/internal/engine"
)

// reportLayout is the shared shell for every ledger-scoped page:
// app chrome + period meta + error banner, then the body.
//
// min-h-full: at least the main viewport (so flex children like config can fill).
// Content taller than the viewport grows and main scrolls as one document —
// no nested body scroller, so charts and tables move together.
templ reportLayout(d pageData) {
	@appLayout(d) {
		<div class="flex min-h-full flex-1 flex-col">
			@periodMeta(d)
			@pageError(d.Error)
			<div class="flex min-h-0 flex-1 flex-col">
				{ children... }
			</div>
		</div>
	}
}

templ pageError(err string) {
	if err != "" {
		<div role="alert" class="alert alert-error alert-soft py-2 text-xs mb-3"><span>{ err }</span></div>
	}
}

templ periodMeta(d pageData) {
	if d.OpCurrency != "" || d.PeriodLabel != "" || d.AsOf != "" {
		<p class="mb-3 text-xs text-base-content/60 flex flex-wrap items-center gap-x-2 gap-y-0.5">
			if d.OpCurrency != "" {
				<span class="font-mono">{ d.OpCurrency }</span>
			}
			if d.PeriodLabel != "" {
				<span class="font-mono text-base-content/80" title={ d.Time }>{ d.PeriodLabel }</span>
			}
			if d.AsOf != "" {
				<span>as of { d.AsOf }</span>
			}
		</p>
	}
}

templ sectionTitle(title string) {
	<h2 class="mb-1.5 text-[0.65rem] font-semibold uppercase tracking-wide text-base-content/50">{ title }</h2>
}

// codeHighlight is server-side chroma highlighting for source text.
// lang is a chroma language name, or "bql" (SQL lexer). Theme colors via .code-hl.
templ codeHighlight(src string, lang string) {
	<style>
		.code-hl { font-size: 0.7rem; line-height: 1.35; }
		.code-hl pre { margin: 0; background: transparent; white-space: pre-wrap; word-break: break-word; }
		.code-hl .hl-k, .code-hl .hl-kd, .code-hl .hl-kn, .code-hl .hl-kc { color: var(--color-primary); font-weight: 600; }
		.code-hl .hl-s, .code-hl .hl-s1, .code-hl .hl-s2, .code-hl .hl-sa { color: var(--color-secondary); }
		.code-hl .hl-c, .code-hl .hl-ch, .code-hl .hl-cm, .code-hl .hl-c1 { color: color-mix(in oklch, var(--color-base-content) 45%, transparent); font-style: italic; }
		.code-hl .hl-m, .code-hl .hl-mi, .code-hl .hl-mf, .code-hl .hl-mh { color: var(--color-info); }
		.code-hl .hl-n, .code-hl .hl-nx, .code-hl .hl-nv, .code-hl .hl-na { color: var(--color-base-content); }
		.code-hl .hl-o, .code-hl .hl-ow, .code-hl .hl-p { color: color-mix(in oklch, var(--color-base-content) 70%, transparent); }
		.code-hl .hl-nf, .code-hl .hl-nb, .code-hl .hl-bp { color: var(--color-accent); }
		.code-hl .hl-err { color: var(--color-error); }
	</style>
	@templ.Raw(highlightSource(src, lang))
}

// sectionTitleExtra is a section heading that can host an inline action (e.g. "all pairs").
templ sectionTitleExtra(title string) {
	<h2 class="mb-1.5 text-[0.65rem] font-semibold uppercase tracking-wide text-base-content/50">
		{ title }
		{ children... }
	</h2>
}

// AccountLink is the shared account <a> (core reports + first-party plugins).
templ AccountLink(s *Session, ledger, account, timeFilter, label string) {
	<a class="link link-hover link-primary" href={ templ.SafeURL(AccountHref(s, ledger, account, timeFilter)) } title={ account }>
		if label != "" {
			{ label }
		} else {
			{ account }
		}
	</a>
}

// CommodityLink is the shared commodity <a> (core reports + first-party plugins).
// mono applies font-mono (tree/amount cells); false for prose-ish prices tables.
templ CommodityLink(s *Session, ledger, commodity, timeFilter string, mono bool) {
	<a
		class={ "link link-hover link-primary", templ.KV("font-mono", mono) }
		href={ templ.SafeURL(CommodityHref(s, ledger, commodity, timeFilter)) }
	>{ commodity }</a>
}

// rateWithQuote is "1.23 USD" with the quote commodity linked (prices tables).
templ rateWithQuote(s *Session, rate, quote, ledger, timeFilter string) {
	{ rate } { " " }
	@CommodityLink(s, ledger, quote, timeFilter, false)
}

// fileLink is a document path: linked when Href is set, plain span otherwise.
templ fileLink(href, path, name string, muted bool) {
	if href != "" {
		<a class="link link-hover link-primary" href={ templ.SafeURL(href) } title={ path }>{ name }</a>
	} else if muted {
		<span class="text-base-content/80" title={ path }>{ name }</span>
	} else {
		<span title={ path }>{ name }</span>
	}
}

// metaMapTable renders a key/value table. indent adds left margin for posting-level meta.
templ metaMapTable(meta ast.Metadata, indent bool) {
	if len(meta) > 0 {
		<table
			class={
				"w-auto border-collapse font-mono text-[0.65rem] leading-tight",
				templ.KV("mt-0.5", !indent),
				templ.KV("ml-2 font-normal", indent),
			}
		>
			<tbody>
				for k, v := range meta {
					<tr>
						<td class="py-0 pr-1.5 pl-0 text-right font-semibold align-baseline whitespace-nowrap">{ k }</td>
						<td
							class={
								"py-0 pl-0 text-left align-baseline",
								templ.KV("text-base-content/70 font-normal", !indent),
								templ.KV("text-base-content/60", indent),
							}
						>{ v }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ metaKVTableRow(key, value string) {
	<tr>
		<td class="text-[0.65rem] uppercase tracking-wide text-base-content/50 w-32">{ key }</td>
		<td class="font-mono text-xs">{ value }</td>
	</tr>
}

// metaKVRows: ordered key/value pairs (commodity meta, etc.).
templ metaKVRows(rows []metaKV) {
	@borderTable() {
		<table class="table table-xs">
			<tbody>
				for _, m := range rows {
					@metaKVTableRow(m.Key, m.Value)
				}
			</tbody>
		</table>
	}
}

// metaInline renders key=value pairs comma-separated (prices tables).
templ metaInline(rows []metaKV) {
	for i, m := range rows {
		if i > 0 {
			{ ", " }
		}
		<span class="font-mono">{ m.Key }</span>={ m.Value }
	}
}

// amountWithCommodityLink is the units/amount cell used by balances and net-worth trees.
templ amountWithCommodityLink(s *Session, amount, commodity, ledger, timeFilter string, isRollup bool) {
	if amount != "" {
		{ amount }
		if commodity != "" {
			{ " " }
			@CommodityLink(s, ledger, commodity, timeFilter, true)
		}
	} else if commodity != "" && !isRollup {
		@CommodityLink(s, ledger, commodity, timeFilter, true)
	}
}

templ treeToggle(isRollup bool) {
	if isRollup {
		<button type="button" class="pnl-toggle btn btn-ghost btn-xs btn-square align-middle h-5 min-h-0 w-5 p-0" data-pnl-toggle aria-expanded="true" title="Collapse">▼</button>
	} else {
		<span class="inline-block w-5" aria-hidden="true"></span>
	}
}

// treeAccountCell is the collapsible account column shared by balances / PnL / networth trees.
templ treeAccountCell(s *Session, row balanceRow, ledger, timeFilter string) {
	<td
		class="font-mono text-xs"
		if row.PadLeft != "" {
			style={ "padding-left: " + row.PadLeft }
		}
	>
		@treeToggle(row.IsRollup)
		@AccountLink(s, ledger, row.Account, timeFilter, row.Name)
	</td>
}

// treeAccountCellNW adapts nwRow to the shared tree account cell.
templ treeAccountCellNW(s *Session, row nwRow, ledger, timeFilter string) {
	@treeAccountCell(s, balanceRow{
		Account:  row.Account,
		Name:     row.Name,
		IsRollup: row.IsRollup,
		PadLeft:  row.PadLeft,
	}, ledger, timeFilter)
}

templ pnlTreeScript() {
	<script src="/static/pnl-tree.js" defer></script>
}

templ emptyNote(msg string) {
	<p class="text-xs text-base-content/60">{ msg }</p>
}

// borderTable wraps a table in the standard overflow + border frame.
templ borderTable() {
	<div class="overflow-x-auto border border-base-300">
		{ children... }
	</div>
}

// amountCommodityRows: account page balance / activity (amount + commodity link).
templ amountCommodityRows(s *Session, rows []balanceRow, ledger, timeFilter, emptyMsg string) {
	if len(rows) == 0 {
		@emptyNote(emptyMsg)
	} else {
		@borderTable() {
			<table class="table table-xs">
				<tbody>
					for _, r := range rows {
						<tr>
							<td class="text-right tabular text-xs font-medium">{ r.Amount }</td>
							<td class="font-mono text-xs">
								@CommodityLink(s, ledger, r.Commodity, timeFilter, false)
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

// accountAmountRows: commodity page balance / activity (account link + amount).
templ accountAmountRows(s *Session, rows []balanceRow, ledger, timeFilter, emptyMsg string) {
	if len(rows) == 0 {
		@emptyNote(emptyMsg)
	} else {
		@borderTable() {
			<table class="table table-xs">
				<thead>
					<tr>
						<th>Account</th>
						<th class="text-right">Amount</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range rows {
						<tr>
							<td class="font-mono text-xs">
								@AccountLink(s, ledger, r.Account, timeFilter, "")
							</td>
							<td class="text-right tabular text-xs font-medium">{ r.Amount }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

// pnlSideTree: income or expenses column on the PnL report.
templ pnlSideTree(s *Session, title string, rows []balanceRow, ledger, timeFilter, emptyMsg string) {
	<section>
		@sectionTitle(title)
		if len(rows) == 0 {
			@emptyNote(emptyMsg)
		} else {
			@borderTable() {
				<table class="table table-xs pnl-tree" data-pnl-tree>
					<tbody>
						for _, r := range rows {
							<tr
								class={ templ.KV("font-semibold bg-base-200/40", r.IsRollup) }
								data-account={ r.Account }
							>
								@treeAccountCell(s, r, ledger, timeFilter)
								<td class="text-right tabular text-xs whitespace-nowrap">
									{ r.Amount }
									if r.Commodity != "" {
										<span class="font-mono text-base-content/60"> { r.Commodity }</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		}
	</section>
}

// journalList renders journal entries with optional account/commodity highlight.
templ journalList(d pageData) {
	if len(d.Journal) == 0 {
		@emptyNote("No journal entries in this range.")
	} else {
		<div class="border border-base-300 divide-y divide-base-300">
			for _, e := range d.Journal {
				@journalEntry(e, d)
			}
		</div>
	}
}

templ journalEntry(e engine.JournalEntry, d pageData) {
	<article class="px-2 py-1.5">
		<div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 text-xs">
			<time class="font-mono tabular text-base-content/70">{ e.Date.Format("2006-01-02") }</time>
			if d.Page == "journal" {
				<span class="text-[0.65rem] uppercase tracking-wide opacity-50">{ e.Kind }</span>
			}
			if e.Payee != "" {
				<span class="font-medium">{ e.Payee }</span>
			}
			if e.Payee != "" && e.Narration != "" {
				<span class="opacity-40">·</span>
			}
			if e.Narration != "" {
				<span
					class={
						templ.KV("text-base-content/80", e.Payee != ""),
						templ.KV("font-medium", e.Payee == ""),
					}
				>{ e.Narration }</span>
			}
			if e.Comment != "" {
				<span class="text-base-content/60">{ e.Comment }</span>
			}
			if d.Page == "journal" && e.Account != "" {
				<span class="font-mono text-[0.7rem]">{ e.Account }</span>
			}
		</div>
		@metaMapTable(e.Metadata, false)
		if len(e.Postings) > 0 {
			<ul class="mt-0.5 space-y-0 font-mono text-xs">
				for _, p := range e.Postings {
					<li
						class={
							"leading-5",
							templ.KV("text-primary font-semibold", journalPostingHighlight(p, d)),
						}
					>
						<div class="flex flex-wrap justify-between gap-2">
							@AccountLink(d.Sess, d.LedgerName, p.Account, d.Time, "")
							if p.Units != nil {
								<span class="tabular text-base-content/90">
									{ p.Units.Number.FloatString(4) + " " }
									@CommodityLink(d.Sess, d.LedgerName, p.Units.Commodity, d.Time, false)
								</span>
							}
						</div>
						@metaMapTable(p.Metadata, true)
					</li>
				}
			</ul>
		}
	</article>
}
