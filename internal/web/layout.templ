package web

// App shell: head, topbar, sidebar, main slot. Every page uses appLayout.

templ head(d pageData) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<meta name="color-scheme" content="light dark"/>
	<title>{ d.Title } · contapila</title>
	<link href="/static/app.css" rel="stylesheet" type="text/css"/>
	if d.NeedCharts {
		@chartAssets()
	}
	<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='4' fill='%231a5632'/%3E%3Ctext x='16' y='21' text-anchor='middle' font-size='14' font-family='system-ui,sans-serif' font-weight='600' fill='%23e8c547'%3Ec%3C/text%3E%3C/svg%3E"/>
	<script>
		(function () {
			try {
				var t = localStorage.getItem("contapila-theme");
				if (t === "contapila-light" || t === "contapila-dark") {
					document.documentElement.setAttribute("data-theme", t);
				} else if (t === "contapila" || t === "light") {
					document.documentElement.setAttribute("data-theme", "contapila-light");
				} else if (t === "dark") {
					document.documentElement.setAttribute("data-theme", "contapila-dark");
				} else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
					document.documentElement.setAttribute("data-theme", "contapila-dark");
				} else {
					document.documentElement.setAttribute("data-theme", "contapila-light");
				}
			} catch (e) {
				document.documentElement.setAttribute("data-theme", "contapila-light");
			}
		})();
	</script>
}

templ themeScript() {
	<script>
		(function () {
			var root = document.documentElement;
			var box = document.getElementById("theme-toggle");
			if (!box) return;
			box.checked = root.getAttribute("data-theme") === "contapila-dark";
			box.addEventListener("change", function () {
				var theme = box.checked ? "contapila-dark" : "contapila-light";
				root.setAttribute("data-theme", theme);
				try { localStorage.setItem("contapila-theme", theme); } catch (e) {}
			});
		})();
	</script>
}

templ timeFilter(d pageData) {
	// Static site has no time query surface; hide the box (live keeps it).
	if d.LedgerName != "" && !sessionStatic(d.Sess) {
		<form method="get" action={ templ.SafeURL(timeFilterAction(d)) } class="shrink-0 flex items-center">
			<input
				id="time-filter"
				type="text"
				name="time"
				value={ d.Time }
				placeholder="2024-03"
				class="input input-xs input-bordered w-28 sm:w-40 font-mono h-6 min-h-0 py-0 leading-none"
				aria-label="Time filter"
				title="2024, 2024-03, 2024-Q1, month, month-1, 2020 - 2024-06"
				autocomplete="off"
				spellcheck="false"
			/>
		</form>
	}
}

templ breadcrumbs(d pageData) {
	<div class="flex min-w-0 flex-1 items-center text-xs sm:text-sm">
		<div class="breadcrumbs py-0 shrink-0 overflow-visible">
			<ul class="flex-nowrap items-center">
				<li><a href={ templ.SafeURL(homeURL(d.Sess)) } class="link link-hover">contapila</a></li>
				if len(d.Ledgers) > 0 {
					<li class="relative z-[60]">
						<details class="dropdown dropdown-bottom">
							<summary class="cursor-pointer list-none font-medium after:hidden whitespace-nowrap">
								if d.LedgerName != "" {
									{ d.LedgerName }
								} else {
									ledger
								}
								<svg xmlns="http://www.w3.org/2000/svg" class="inline h-3 w-3 opacity-50 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
							</summary>
							<ul class="dropdown-content menu menu-sm bg-base-100 rounded-box z-[70] w-48 p-1.5 shadow-md border border-base-300">
								for _, name := range d.Ledgers {
									<li>
										if d.Page == "account" && d.AccountName != "" {
											<a href={ templ.SafeURL(accountURL(d.Sess, name, d.AccountName, d.Time)) } class={ templ.KV("menu-active", d.LedgerName == name) }>{ name }</a>
										} else if d.Page == "commodity" && d.CommodityName != "" {
											<a href={ templ.SafeURL(commodityURL(d.Sess, name, d.CommodityName, d.Time)) } class={ templ.KV("menu-active", d.LedgerName == name) }>{ name }</a>
										} else if d.Page == "query" && d.QueryName != "" {
											<a href={ templ.SafeURL(queryURL(d.Sess, name, d.QueryName, d.Time)) } class={ templ.KV("menu-active", d.LedgerName == name) }>{ name }</a>
										} else if d.Page != "" {
											<a href={ templ.SafeURL(ledgerURL(d.Sess, name, d.Page, d.Time)) } class={ templ.KV("menu-active", d.LedgerName == name) }>{ name }</a>
										} else {
											<a href={ templ.SafeURL(ledgerURL(d.Sess, name, "check", "")) } class={ templ.KV("menu-active", d.LedgerName == name) }>{ name }</a>
										}
									</li>
								}
							</ul>
						</details>
					</li>
				}
				if d.LedgerName != "" && d.Page != "" && d.Page != "account" && d.Page != "commodity" && d.Page != "query" {
					<li class="whitespace-nowrap">{ pageTitle(d) }</li>
				}
			</ul>
		</div>
		if d.LedgerName != "" && d.Page == "account" && d.AccountName != "" {
			@breadcrumbTail(d.AccountName)
		} else if d.LedgerName != "" && d.Page == "commodity" && d.CommodityName != "" {
			@breadcrumbTail(d.CommodityName)
		} else if d.LedgerName != "" && d.Page == "query" && d.QueryName != "" {
			@breadcrumbTail(d.QueryName)
		}
	</div>
}

templ topbar(d pageData) {
	<header class="w-full shrink-0 navbar h-10 min-h-0 max-h-10 py-0 bg-base-200 border-b border-base-300 px-2 sm:px-3 gap-2 sticky top-0 z-50 overflow-visible">
		<div class="navbar-start gap-1 min-w-0 flex-1 h-full items-center overflow-visible">
			<label for="nav-open" class="btn btn-ghost btn-xs btn-square shrink-0 lg:hidden" aria-label="Open menu">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path></svg>
			</label>
			@breadcrumbs(d)
		</div>
		<div class="navbar-end gap-1.5 shrink-0 h-full items-center">
			@timeFilter(d)
			<label class="swap swap-rotate btn btn-ghost btn-xs btn-square" title="Toggle light / dark">
				<input id="theme-toggle" type="checkbox" class="theme-controller" value="contapila-dark" aria-label="Toggle dark theme"/>
				<svg class="swap-off h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"></path></svg>
				<svg class="swap-on h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M21.752 15.002A9.72 9.72 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"></path></svg>
			</label>
		</div>
	</header>
}

templ navItem(d pageData, page, label string) {
	<li class="w-full">
		<a href={ templ.SafeURL(ledgerURL(d.Sess, d.LedgerName, page, d.Time)) } class={ "rounded-none w-full", templ.KV("menu-active", d.Page == page) }>{ label }</a>
	</li>
}

templ sidebarCurrentEntity(title, name string) {
	<li class="menu-title px-3 py-2 mt-1 text-[0.65rem]"><span>{ title }</span></li>
	<li class="w-full">
		<span class="menu-active rounded-none w-full font-mono text-[0.7rem] break-all">{ name }</span>
	</li>
}

templ breadcrumbTail(name string) {
	<span class="breadcrumbs-sep opacity-40 mx-1.5 shrink-0 text-[0.65rem]" aria-hidden="true">›</span>
	<span class="min-w-0 flex-1 overflow-x-auto font-mono text-xs whitespace-nowrap py-0" title={ name }>{ name }</span>
}

templ sidebarQueryNav(d pageData, name string) {
	<li class="w-full">
		<a href={ templ.SafeURL(queryURL(d.Sess, d.LedgerName, name, d.Time)) } class={ "rounded-none w-full font-mono text-[0.7rem]", templ.KV("menu-active", d.Page == "query" && d.QueryName == name) }>{ name }</a>
	</li>
}

templ sidebarNav(d pageData) {
	if d.LedgerName != "" {
		<ul class="menu menu-sm w-full p-0 gap-0 rounded-none">
			<li class="menu-title px-3 py-2 text-[0.65rem]"><span>Reports</span></li>
			for _, p := range sidebarReportPages(d) {
				@navItem(d, p.ID, p.Label)
			}
			if len(d.QueryNav) > 0 && queriesUIEnabled(d) {
				<li class="menu-title px-3 py-2 mt-1 text-[0.65rem]"><span>Queries</span></li>
				for _, q := range d.QueryNav {
					@sidebarQueryNav(d, q.Name)
				}
			}
			if d.Page == "account" {
				@sidebarCurrentEntity("Account", d.AccountName)
			}
			if d.Page == "commodity" {
				@sidebarCurrentEntity("Commodity", d.CommodityName)
			}
		</ul>
	} else if len(d.Ledgers) > 0 {
		<ul class="menu menu-sm w-full p-0 gap-0 rounded-none">
			<li class="menu-title px-3 py-2 text-[0.65rem]"><span>Ledgers</span></li>
			for _, name := range d.Ledgers {
				<li class="w-full">
					<a href={ templ.SafeURL(ledgerURL(d.Sess, name, "check", "")) } class="rounded-none w-full">{ name }</a>
				</li>
			}
		</ul>
	} else {
		<p class="p-3 text-xs text-base-content/60">No ledgers.</p>
	}
}

// appLayout is the shared HTML document shell. Body content goes in children.
templ appLayout(d pageData) {
	<!doctype html>
	<html lang="en" data-theme="contapila-light">
		<head>
			@head(d)
		</head>
		<body class="bg-base-100 text-base-content h-screen max-h-screen overflow-hidden text-sm">
			<div class="flex flex-col h-full min-h-0">
				@topbar(d)
				<div class="flex flex-1 min-h-0 relative">
					<input id="nav-open" type="checkbox" class="peer/nav sr-only"/>
					<label
						for="nav-open"
						class="fixed inset-x-0 bottom-0 top-10 z-30 bg-black/40 opacity-0 pointer-events-none peer-checked/nav:opacity-100 peer-checked/nav:pointer-events-auto lg:hidden"
						aria-label="Close menu"
					></label>
					<aside class="app-sidebar shrink-0 w-52 bg-base-200 border-r border-base-300 flex flex-col min-h-0 overflow-y-auto z-40 fixed lg:static inset-y-0 left-0 top-10 lg:top-auto lg:inset-auto -translate-x-full peer-checked/nav:translate-x-0 lg:translate-x-0 transition-transform duration-150 ease-out">
						@sidebarNav(d)
					</aside>
					<main class="flex-1 min-w-0 min-h-0 overflow-y-auto px-3 py-3 sm:px-4 sm:py-4">
						{ children... }
					</main>
				</div>
			</div>
			@themeScript()
		</body>
	</html>
}
