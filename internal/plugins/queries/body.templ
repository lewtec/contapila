package queries

import "github.com/lucasew/contapila-go/internal/web"

templ queriesBody(d web.PageData) {
	if len(d.QueryList) == 0 {
		<p class="text-xs text-base-content/60">No query directives in this ledger.</p>
	} else {
		<div class="overflow-x-auto border border-base-300">
			<table class="table table-xs">
				<thead>
					<tr>
						<th class="w-28">Date</th>
						<th class="w-40">Name</th>
						<th>Query</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range d.QueryList {
						<tr>
							<td class="tabular text-xs whitespace-nowrap">{ row.Date }</td>
							<td class="font-mono text-[0.7rem]">
								if row.Name != "" {
									<a href={ templ.SafeURL(web.QueryHref(d.Sess, d.LedgerName, row.Name, d.Time)) } class="link link-hover">{ row.Name }</a>
								}
							</td>
							<td class="font-mono text-[0.7rem] max-w-xl truncate" title={ row.Text }>{ row.Text }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<p class="mt-3 text-xs text-base-content/60">
			Named queries also appear in the sidebar. Results (BQL) are not run yet.
		</p>
	}
}
